# ──────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES TEMPLATE
#
# Copy this file to .env and fill in your actual API keys:
#   cp .env.example .env
#
# ⚠️ NEVER commit .env to Git — it contains your secrets!
#    .env.example is safe to commit (it has no real keys).
# ──────────────────────────────────────────────────────────────────────────

# LLM model identifier (provider/model-name)
MODEL=groq/openai/gpt-oss-120b

# Groq API Key — powers the LLM for all agents
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Serper API Key — powers the SerperDevTool (web search)
# Get yours at: https://serper.dev (free: 2,500 searches)
SERPER_API_KEY=your_serper_api_key_here
